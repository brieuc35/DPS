rules_version = '2';

// =============================================================================
// DPS Collective — règles de sécurité Firestore
// -----------------------------------------------------------------------------
// Ce fichier est la vraie serrure du site. La clé d'API publiée dans les pages
// n'autorise rien : c'est ici, et seulement ici, que se décide qui peut lire et
// écrire quoi. Tout ce qui n'est pas explicitement permis est refusé.
//
// À déployer depuis la racine du dépôt :
//     firebase deploy --only firestore:rules
// ou en collant ce contenu dans la console : Firestore → Règles.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function connecte() {
      return request.auth != null;
    }

    function moi() {
      return request.auth.uid;
    }

    // Un membre est inscrit à une sortie si le document de réservation dont
    // l'identifiant est « <activité>_<uid> » existe. L'identifiant est composé
    // exprès pour que cette vérification tienne en une lecture directe, sans
    // requête — une règle ne peut pas faire de recherche.
    function inscritA(activiteId) {
      return exists(/databases/$(database)/documents/reservations/$(activiteId + '_' + moi()));
    }

    // « groupe-mine-bleue » → « mine-bleue ».
    function activiteDuFil(conversation) {
      return conversation.split('groupe-')[1];
    }

    function texteAcceptable(donnees) {
      return donnees.texte is string
          && donnees.texte.size() > 0
          && donnees.texte.size() <= 600;
    }

    // Même forme que `texteAcceptable`, pour le champ `contenu` d'une
    // publication — un nom différent côté site, pour ne pas confondre une
    // publication du fil avec un message de discussion.
    function contenuAcceptable(donnees) {
      return donnees.contenu is string
          && donnees.contenu.size() > 0
          && donnees.contenu.size() <= 600;
    }

    // -------------------------------------------------------------- messages
    match /messages/{messageId} {

      // Le salon est ouvert à tous les membres ; le fil d'une sortie ne l'est
      // qu'à ses inscrits. C'est la traduction technique de la promesse « ce
      // qui se dit dans le groupe y reste ».
      function peutVoir(conversation) {
        return conversation == 'general'
            || (conversation.matches('groupe-.*') && inscritA(activiteDuFil(conversation)));
      }

      // Deux cas de lecture : les messages d'un fil auquel on a accès, et les
      // siens propres — nécessaires pour pouvoir les effacer en supprimant son
      // compte, y compris dans un fil qu'on a depuis quitté.
      allow read: if connecte()
                  && (peutVoir(resource.data.conversation)
                      || resource.data.auteurId == moi());

      // On n'écrit que sous sa propre identité : `auteurId` doit être l'uid de
      // la session. Sans cela, n'importe qui pourrait publier sous le nom d'un
      // autre. `date` doit venir du serveur, sinon un navigateur mal réglé — ou
      // malveillant — placerait ses messages en tête de fil.
      allow create: if connecte()
                    && peutVoir(request.resource.data.conversation)
                    && request.resource.data.auteurId == moi()
                    && request.resource.data.date == request.time
                    && texteAcceptable(request.resource.data);

      // Un message ne se modifie pas. Le supprimer reste possible pour son
      // auteur : on peut vouloir retirer ce qu'on a écrit.
      allow update: if false;
      allow delete: if connecte() && resource.data.auteurId == moi();
    }

    // ---------------------------------------------------------- réservations
    match /reservations/{reservationId} {

      // Chacun voit les siennes. Personne ne consulte la liste des inscrits
      // d'une sortie : ce serait publier qui va où.
      allow read: if connecte() && resource.data.membreId == moi();

      // L'identifiant est imposé : il vaut « <activité>_<uid> ». C'est ce qui
      // rend la double réservation impossible et permet aux règles des messages
      // de vérifier une inscription sans requête.
      // Une inscription vaut exactement une place : un compte, une personne.
      // La borne était de 1 à 4 du temps où l'on pouvait réserver pour un
      // groupe ; la laisser ouverte permettrait à quelqu'un contournant le
      // formulaire de prendre quatre places d'un coup.
      allow create: if connecte()
                    && request.resource.data.membreId == moi()
                    && reservationId == request.resource.data.activiteId + '_' + moi()
                    && request.resource.data.places is int
                    && request.resource.data.places == 1;

      // Se désinscrire reste possible ; modifier sa réservation, non — il
      // faudrait alors retoucher le compteur dans le même mouvement.
      allow update: if false;
      allow delete: if connecte() && resource.data.membreId == moi();
    }

    // ---------------------------------------------------- compteurs de places
    match /activites/{activiteId} {

      // Les jauges sont publiques : elles s'affichent avant toute connexion.
      allow read: if true;

      // Le compteur ne bouge que dans le même mouvement qu'une réservation, et
      // seulement vers le haut. Ces règles ne peuvent pas vérifier que la
      // transaction est cohérente de bout en bout — un membre déterminé peut
      // encore fausser le compteur. Le jour où une place vaudra de l'argent,
      // ce calcul devra passer dans une Cloud Function, seule à pouvoir écrire
      // ici.
      allow create: if connecte() && request.resource.data.placesPrises is int;

      // Le compteur monte quand une place est prise, redescend quand une
      // inscription disparaît — sans quoi une sortie resterait affichée complète
      // après une suppression de compte. Le pas est borné dans les deux sens :
      // c'est le maximum de places qu'une seule inscription peut représenter.
      allow update: if connecte()
                    && request.resource.data.placesPrises is int
                    && request.resource.data.placesPrises >= 0
                    && request.resource.data.placesPrises != resource.data.placesPrises
                    && request.resource.data.placesPrises <= resource.data.placesPrises + 4
                    && request.resource.data.placesPrises >= resource.data.placesPrises - 4;
      allow delete: if false;
    }

    // -------------------------------------------------------- publications
    match /publications/{publicationId} {

      // Public, comme les jauges : le fil se parcourt avant toute connexion,
      // seule la question d'entrée (posée côté site, pas ici) filtre qui
      // arrive jusque-là.
      allow read: if true;

      // Une publication ordinaire porte l'identité de son autrice ou auteur.
      // Une annonce automatique (pont activités → fil) porte, elle, un
      // identifiant déterministe — « annonce-<activité> » — pour qu'une
      // deuxième tentative ne puisse pas en recréer une seconde : Firestore
      // traite alors l'écriture comme une modification, et `allow update`
      // plus bas la refuse. N'importe quel membre connecté peut être celui
      // qui la déclenche — le site n'a pas de service qui tourne seul en
      // arrière-plan, ce sont les visites qui la font apparaître.
      allow create: if connecte()
                    && request.resource.data.auteurId == moi()
                    && request.resource.data.date == request.time
                    && request.resource.data.cercle is string
                    && request.resource.data.cercle.size() > 0
                    && request.resource.data.jaimesCompte == 0
                    && contenuAcceptable(request.resource.data);

      // Recréer une publication existante est refusé (voir plus haut, pour
      // les annonces automatiques). La seule modification tolérée est le
      // compteur de soutiens, d'un pas à la fois — même logique que le
      // compteur de places d'une activité : quiconque est connecté peut
      // faire évoluer ce nombre, mais rien d'autre dans le document ne peut
      // changer au même moment.
      allow update: if connecte()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['jaimesCompte'])
                    && request.resource.data.jaimesCompte is int
                    && request.resource.data.jaimesCompte >= 0
                    && request.resource.data.jaimesCompte != resource.data.jaimesCompte
                    && request.resource.data.jaimesCompte <= resource.data.jaimesCompte + 1
                    && request.resource.data.jaimesCompte >= resource.data.jaimesCompte - 1;
      allow delete: if connecte() && resource.data.auteurId == moi();
    }

    // ------------------------------------------------------------ réponses
    match /reponses/{reponseId} {

      // Publiques au même titre que les publications qu'elles complètent.
      allow read: if true;

      allow create: if connecte()
                    && request.resource.data.auteurId == moi()
                    && request.resource.data.date == request.time
                    && request.resource.data.publicationId is string
                    && texteAcceptable(request.resource.data);

      allow update: if false;
      allow delete: if connecte() && resource.data.auteurId == moi();
    }

    // -------------------------------------------------------------- soutiens
    match /jaimes/{jaimeId} {

      // Chacun ne voit que les siens : le compteur public suffit à tout le
      // monde, savoir précisément qui a soutenu quoi ne regarde que l'auteur
      // du soutien.
      allow read: if connecte() && resource.data.membreId == moi();

      // Même principe que les réservations : l'identifiant composé
      // « <publication>_<uid> » rend un double soutien impossible sans
      // requête, et le prouve d'une seule lecture.
      allow create: if connecte()
                    && request.resource.data.membreId == moi()
                    && jaimeId == request.resource.data.publicationId + '_' + moi();

      allow update: if false;
      allow delete: if connecte() && resource.data.membreId == moi();
    }

    // Tout le reste est fermé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
